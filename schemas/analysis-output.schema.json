{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "clarification_questions",
    "proposed_tasks",
    "scope_assessment",
    "deadline_quote"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "description",
          "source_quote",
          "needs_clarification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          },
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "bug",
              "improvement",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "needs_clarification": {
            "type": "boolean"
          }
        }
      }
    },
    "clarification_questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "proposed_tasks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "type",
          "requirement_ids",
          "acceptance_criteria",
          "blocked_by_clarification"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "bug",
              "improvement",
              "other"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 10
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "blocked_by_clarification": {
            "type": "boolean"
          }
        }
      }
    },
    "scope_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "related_requirement_ids"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "within_scope",
            "potential_change",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "related_requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10
          }
        }
      }
    },
    "deadline_quote": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  }
}
